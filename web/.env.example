# Copy to web/.env.local. Never commit a real key.
# On Vercel nothing is needed here: the AI Gateway authenticates with the project's OIDC token.
# Locally, either set AI_GATEWAY_API_KEY or run `vercel env pull .env.local` to get VERCEL_OIDC_TOKEN.
# With neither, Explain uses the template in lib/explainTemplate.js.
AI_GATEWAY_API_KEY=
# Optional. Any AI Gateway provider/model string. Default: anthropic/claude-haiku-4.5
AI_MODEL=
# Optional. Set to off to always use the template.
AI_EXPLANATIONS=
